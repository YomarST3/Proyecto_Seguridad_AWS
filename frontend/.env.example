# ==============================================================================
# SALESIA ENTERPRISE - VARIABLES DE ENTORNO (FRONTEND)
# ==============================================================================

# URL base de la API REST (En local el proxy de Vite redirige /api/v1 a http://127.0.0.1:8000)
VITE_API_BASE_URL=/api/v1

# Supabase Auth (Credenciales públicas cliente - Anon Key)
# Reemplazar con las credenciales de tu proyecto en Supabase (Settings > API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
