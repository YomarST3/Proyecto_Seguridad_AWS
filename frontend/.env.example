# URL base de la API REST
# En desarrollo local con Vite proxy: /api/v1
# En producción (Cloudflare Pages): https://tu-backend.ngrok-free.app/api/v1
VITE_API_BASE_URL=/api/v1

# Supabase Auth (Credenciales públicas de cliente - Anon/Publishable Key)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key-here
