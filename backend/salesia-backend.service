[Unit]
Description=SalesIA Enterprise FastAPI Backend Service
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/salesia/backend
ExecStart=/opt/salesia/backend/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 2
Restart=always
RestartSec=5s
EnvironmentFile=/opt/salesia/backend/.env
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
