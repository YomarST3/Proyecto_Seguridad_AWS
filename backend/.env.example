# ==============================================================================
# SALESIA ENTERPRISE - VARIABLES DE ENTORNO DE EJEMPLO (PLANTILLA SEGURA)
# ==============================================================================

PROJECT_NAME="SalesIA Enterprise"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"

# Supabase Auth Oficial
SUPABASE_URL="https://[YOUR_PROJECT_ID].supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_anon_key"
SUPABASE_ANON_KEY="sb_publishable_your_anon_key"
SUPABASE_SERVICE_ROLE_KEY="sb_secret_your_service_role_key"
SUPABASE_JWT_JWKS_URL="https://[YOUR_PROJECT_ID].supabase.co/auth/v1/.well-known/jwks.json"
SUPABASE_JWT_SECRET="your-supabase-jwt-secret-here"
SUPABASE_JWT_ALGORITHM="HS256"

# Cadena de Conexión PostgreSQL (Supabase Pooler en puerto 5432 o 6543)
# Formato: postgresql+psycopg2://postgres.[PROJECT_ID]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
DATABASE_URL="postgresql+psycopg2://postgres.[PROJECT_ID]:[TU_PASSWORD]@aws-0-us-east-2.pooler.supabase.com:5432/postgres"
DIRECT_DATABASE_URL="postgresql+psycopg2://postgres.[PROJECT_ID]:[TU_PASSWORD]@aws-0-us-east-2.pooler.supabase.com:5432/postgres"

# Fallback Local PostgreSQL (Opcional)
POSTGRES_SERVER=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=salesia_db

# CORS Permitidos
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000"]

# Frontend URL en producción (dominio exacto de Cloudflare Pages u otro hosting)
# Ejemplo: https://salesia-enterprise.pages.dev
FRONTEND_URL=
